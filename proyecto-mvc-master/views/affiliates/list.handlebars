<div class="card p-4 shadow">

  <div class="d-flex justify-content-between align-items-center mb-4">

    <h1>Listado de afiliados</h1>

    <a
      href="/affiliates/create"
      class="btn btn-success"
    >
      Crear afiliado
    </a>

  </div>

  <table class="table table-striped table-hover">

    <thead class="table-dark">

      <tr>
        <th>ID</th>
        <th>Nombre</th>
        <th>Apellido</th>
        <th>Email</th>
        <th>Membresía</th>
        <th>Acciones</th>
      </tr>

    </thead>

    <tbody>

      {{#each affiliates}}

        <tr>

          <td>{{this.id}}</td>

          <td>{{this.firstName}}</td>

          <td>{{this.lastName}}</td>

          <td>{{this.email}}</td>

          <td>{{this.membershipType}}</td>

          <td>

            <a
              href="/affiliates/{{this.id}}"
              class="btn btn-primary btn-sm"
            >
              Ver detalle
            </a>

          </td>

        </tr>

      {{/each}}

    </tbody>

  </table>

</div>