<div class="card p-4 shadow mx-auto" style="max-width: 500px;">

  <h1 class="mb-4 text-center">Registrar usuario</h1>

  <form method="POST" action="/login/register">

    <div class="mb-3">
      <label class="form-label">Correo</label>
      <input
        type="text"
        name="email"
        class="form-control"
        value="{{old.email}}"
      >

      {{#if errors.email}}
        <div class="text-danger mt-1">
          {{errors.email.[0]}}
        </div>
      {{/if}}
    </div>

    <div class="mb-4">
      <label class="form-label">Contraseña</label>
      <input
        type="password"
        name="password"
        class="form-control"
      >

      {{#if errors.password}}
        <div class="text-danger mt-1">
          {{errors.password.[0]}}
        </div>
      {{/if}}
    </div>

    <button type="submit" class="btn btn-success w-100">
      Crear cuenta
    </button>

  </form>

  <p class="mt-3 text-center">
    ¿Ya tienes cuenta?
    <a href="/login">Inicia sesión aquí</a>
  </p>

</div>