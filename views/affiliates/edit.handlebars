<div class="card p-4 shadow">

  <h1 class="mb-4">
    Editar afiliado
  </h1>

  <form
    method="POST"
    action="/affiliates/edit/{{affiliate.id}}"
  >

    <div class="mb-3">

      <label class="form-label">
        Nombre
      </label>

      <input
        type="text"
        name="firstName"
        value="{{affiliate.firstName}}"
        class="form-control"
        required
      >

    </div>

    <div class="mb-3">

      <label class="form-label">
        Apellido
      </label>

      <input
        type="text"
        name="lastName"
        value="{{affiliate.lastName}}"
        class="form-control"
        required
      >

    </div>

    <div class="mb-3">

      <label class="form-label">
        Correo
      </label>

      <input
        type="email"
        name="email"
        value="{{affiliate.email}}"
        class="form-control"
        required
      >

    </div>

    <div class="mb-4">

      <label class="form-label">
        Membresía
      </label>

      <select
        name="membershipType"
        class="form-select"
      >

        <option value="silver">
          Silver
        </option>

        <option value="gold">
          Gold
        </option>

        <option value="platinium">
          Platinium
        </option>

      </select>

    </div>

    <div class="d-flex gap-2">

      <button
        type="submit"
        class="btn btn-primary"
      >
        Actualizar afiliado
      </button>

      <a
        href="/affiliates"
        class="btn btn-secondary"
      >
        Volver
      </a>

    </div>

  </form>

</div>