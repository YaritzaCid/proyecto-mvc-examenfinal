<div class="card shadow p-4">

  <div class="d-flex justify-content-between align-items-center mb-4">

    <h1>
      Detalle afiliado
    </h1>

    <span class="badge bg-primary fs-6">
      {{affiliate.membershipType}}
    </span>

  </div>

  <div class="row">

    <div class="col-md-6 mb-3">

      <label class="form-label text-muted">
        Nombre
      </label>

      <div class="form-control">
        {{affiliate.firstName}}
      </div>

    </div>

    <div class="col-md-6 mb-3">

      <label class="form-label text-muted">
        Apellido
      </label>

      <div class="form-control">
        {{affiliate.lastName}}
      </div>

    </div>

    <div class="col-md-12 mb-4">

      <label class="form-label text-muted">
        Email
      </label>

      <div class="form-control">
        {{affiliate.email}}
      </div>

    </div>

  </div>

  <div class="d-flex gap-2 mb-4">

    <a
      href="/affiliates/edit/{{affiliate.id}}"
      class="btn btn-primary"
    >
      Editar afiliado
    </a>

    <a
      href="/affiliates"
      class="btn btn-secondary"
    >
      Volver
    </a>

    <form
      method="POST"
      action="/affiliates/delete/{{affiliate.id}}"
    >

      <button
        type="submit"
        class="btn btn-danger"
      >
        Eliminar
      </button>

    </form>

  </div>

  <hr>

  <h3 class="mb-4">
    Simulador de descuento
  </h3>

  <form
    method="POST"
    action="/affiliates/{{affiliate.id}}/simulate"
  >

    <div class="mb-3">

      <label class="form-label">
        Monto tratamiento
      </label>

      <input
        type="number"
        name="amount"
        class="form-control"
        required
      >

    </div>

    <button
      type="submit"
      class="btn btn-success"
    >
      Calcular descuento
    </button>

  </form>

  {{#if finalPrice}}

    <div class="alert alert-success mt-4">

      <h5>
        Resultado simulación
      </h5>

      <p>
        <strong>Monto:</strong>
        ${{amount}}
      </p>

      <p>
        <strong>Descuento:</strong>
        {{discountPercent}}%
      </p>

      <p>
        <strong>Total final:</strong>
        ${{finalPrice}}
      </p>

    </div>

  {{/if}}

</div>